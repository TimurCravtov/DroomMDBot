# Used by the "web" service in docker-compose.yml. SITE_ADDRESS is your domain for
# automatic HTTPS (Let's Encrypt), or ":80" to serve plain HTTP, e.g. for a quick test.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# The API (including the live-vehicle event stream) goes to the Go server.
	handle /api/* {
		reverse_proxy server:8080 {
			# Send each server-sent event immediately instead of buffering the stream.
			flush_interval -1
		}
	}

	handle /healthz {
		reverse_proxy server:8080
	}

	# Everything else is the single-page client; unknown paths fall back to index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server

		# Hashed assets never change: cache them for a year. The page itself is not cached.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
	}
}
