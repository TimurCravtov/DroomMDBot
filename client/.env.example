# Copy to .env (git-ignored) for development, or to .env.production for `npm run build`.
# Vite only exposes variables that start with VITE_ to the browser: never put secrets here.

# --- API server (the Go server in ../server) -------------------------------------------
# Where the client finds the API.
#   /api                      same origin. In development Vite proxies /api to DEV_API_TARGET;
#                             in production your reverse proxy (see ../deploy/Caddyfile) does.
#   https://api.example.com/api   a separate domain. The server must then allow this site's
#                             origin: set CORS_ORIGIN=https://your-site.example in the server env.
VITE_API_URL=/api

# Development only (not exposed to the browser): where the Vite dev server forwards /api.
# Point it at your VPS to develop against the deployed server.
DEV_API_TARGET=http://localhost:8080

# "true" ignores the API entirely and runs on built-in mock data.
VITE_USE_MOCK=false

# --- Map ---------------------------------------------------------------------------------
# CARTO basemaps key (free): https://www.carto.com/basemaps/apikey/
VITE_CARTO_API_KEY=
