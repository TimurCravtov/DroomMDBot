# Settings for the API server. Copy to server/.env (git-ignored) and fill in; on Coolify, set
# the same names in the server resource's Environment Variables instead.

# Tranzy open data key, used by server/ — free at https://apps.tranzy.ai/accounts
TRANZY_API_KEY=

# Telegram bot token (from @BotFather). The server verifies Mini App sign-ins with it and runs
# the bot itself: /start replies with a button that opens the app.
TELEGRAM_BOT_TOKEN=

# The deployed client, which the bot's button and menu button open. Must be https.
# APP_URL=https://app.example.com

# Set to false wherever you run the server with a token that is also used by a deployed server
# (for example on your laptop): the bot polls for messages, and two pollers on one token fight.
# BOT_ENABLED=true

# --- Server auth and storage (see server/README.md) ---------------------------------------
# SQLite database file. In Docker this is /data/droommd.db inside the "droommd-data" volume.
# DB_PATH=data/droommd.db

# Testing outside Telegram: lets any browser create an anonymous account. Leave OFF in
# production (or users in plain browsers can create accounts freely).
AUTH_ALLOW_ANON=false

# Origins allowed to call the API from another domain, comma-separated and exact (scheme + domain,
# no trailing slash). REQUIRED when the client and the API are on different domains, for example
# CORS_ORIGIN=https://bus.example.com. Empty means CORS is off: only a client served from the
# same origin (or through the Vite dev proxy) can call the API.
CORS_ORIGIN=

# Rolling database backups (written next to the database, in <DB_PATH dir>/backups).
# BACKUP_EVERY=24h      # "off" disables
# BACKUP_KEEP=7
